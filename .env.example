# Any OpenAI-compatible chat-completions endpoint.
SHORT_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
SHORT_RESEARCH_LLM_API_KEY=
SHORT_RESEARCH_LLM_MODEL=

# Optional per-call cost ceiling used by the model router.
SHORT_RESEARCH_MAX_LLM_USD_PER_CALL=

# Optional task routes. Highest-quality affordable candidate is selected.
# Example:
# SHORT_RESEARCH_MODEL_ROUTES_JSON={"research":[{"model":"cheap-model","quality":55,"input_per_million":0.2,"output_per_million":0.8}],"critic":[{"model":"strong-model","quality":90,"input_per_million":2.0,"output_per_million":8.0}]}
SHORT_RESEARCH_MODEL_ROUTES_JSON=

# Optional: push/trigger against a self-hosted ArcReel instance.
ARCREEL_BASE_URL=http://localhost:8000
ARCREEL_TOKEN=
